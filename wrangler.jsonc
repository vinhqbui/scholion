{
  // Static site for open.margincode.dev: serves site/ as is, no Worker code.
  "name": "scholion-deploy",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },
  // Cloudflare's Git integration runs `wrangler preview` for non-production branches; it needs
  // this block, even empty.
  "previews": {},
  // Custom domain: the zone margincode.dev must be on the Cloudflare account before a deploy.
  // The Worker keeps its earlier name: a new name would be a new Worker without its domains
  // and secrets. The old address is redirected in its own zone (site/README.md).
  "routes": [
    { "pattern": "open.margincode.dev", "custom_domain": true }
  ]
}
