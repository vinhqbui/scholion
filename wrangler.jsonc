{
  // Static site for openevaluations.si: serves site/ as is, no Worker code.
  "name": "scholion-deploy",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },
  // Cloudflare's Git integration runs `wrangler preview` for non-production branches; it needs
  // this block, even empty.
  "previews": {}
}
